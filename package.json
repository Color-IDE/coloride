{
  "name": "coloride",
  "version": "0.1.28",
  "private": false,
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "concurrently --kill-others --prefix-colors \"blue,green\" --names \"VITE,ELECTRON\" \"pnpm dev:web\" \"pnpm dev:electron\"",
    "dev:web": "pnpm --filter @coloride/web dev",
    "dev:electron": "pnpm exec wait-on http://127.0.0.1:5173 && node tooling/dev/dev-electron.cjs",
    "build:web": "pnpm --filter @coloride/web build",
    "desktop": "pnpm build:web && pnpm --filter @coloride/electron start",
    "desktop:dev": "cross-env COLORIDE_DEV=1 pnpm exec electron client/desktop/src/main.cjs",
    "desktop:dist": "pnpm build:web && pnpm --filter @coloride/electron dist",
    "desktop:release": "pnpm build:web && pnpm --filter @coloride/electron dist:publish",
    "desktop:release:signed": "./tooling/release/macos-sign-release.sh",
    "desktop:release:signed:publish": "./tooling/release/macos-sign-release.sh --publish",
    "desktop:dist:win": "pnpm build:web && pnpm --filter @coloride/electron dist:win",
    "desktop:release:win": "pnpm build:web && pnpm --filter @coloride/electron dist:win:publish",
    "desktop:release:all": "echo 'Push a vX.Y.Z tag or run Release Desktop in GitHub Actions to build draft release assets.'",
    "desktop:deploy-downloads": "./tooling/release/deploy-downloads.sh",
    "desktop:deploy-downloads:dry": "./tooling/release/deploy-downloads.sh --dry-run",
    "typecheck": "pnpm check:structure && pnpm --filter @coloride/contracts typecheck && pnpm --filter @coloride/web typecheck",
    "verify": "./tooling/checks/verify.sh",
    "test:terminal": "pnpm test:electron terminal/",
    "test:electron": "playwright test --config tests/electron/playwright.config.ts",
    "check:structure": "node tooling/checks/check-structure.mjs",
    "test:unit": "node tooling/checks/test-renderer.mjs",
    "check:unused": "pnpm typecheck && node tooling/checks/audit-source.mjs",
    "bench:startup": "node tests/electron/benchmarks/desktop.mjs",
    "bench:file-open": "node tests/electron/benchmarks/desktop.mjs --scenario file-open",
    "bench:compare:prepare": "node tests/electron/benchmarks/compare.mjs",
    "test:benchmarks": "node --test tests/electron/benchmarks/protocol.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "electron": "43.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "wait-on": "^8.0.1"
  }
}
